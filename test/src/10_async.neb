import { section, expectEq, expect } from "_runner"

--- Pretend "async" primitive: takes a callback and invokes it synchronously
--- with the given value. `await` adapts to this callback shape automatically.
local function instant(value: string, callback: (string) -> nil): nil
    callback(value)
end

async function fetchHello(): string
    local greet = await instant("hello")
    return greet .. ", world"
end

async function fetchTwoStep(): string
    local a = await instant("AA")
    local b = await instant("BB")
    return a .. b
end

async function guarded(fail: boolean): string
    try
        local value = await instant("ok")
        if fail then error("bad", 0) end
        return value
    catch (err)
        return "caught " .. tostring(err)
    end
end

async function returnsNumber(n: number): number
    local v = await instant(tostring(n))
    return tonumber(v)!
end

class Fetcher
    prefix: string

    constructor(prefix: string)
        self.prefix = prefix
    end

    async function fetch(value: string): string
        local v = await instant(self.prefix .. value)
        return v
    end

    async function fetchTwice(value: string): string
        local a = await self:fetch(value)
        local b = await self:fetch(value)
        return a .. b
    end

    static async function ping(): string
        local v = await instant("pong")
        return v
    end
end

extend string
    async function fetchUpper(): string
        local v = await instant(string.upper(self))
        return v
    end
end

async function viaAny(box: any): string
    local value = await box:fetch("dyn")
    return value
end

class CallbackSource
    function fetch(key: string, cb: (string) -> nil): nil
        cb("value:" .. key)
    end
end

interface CallbackRemote
    function fetch(key: string, cb: (string) -> nil): nil
end

class CallbackMirror implements CallbackRemote
    function fetch(key: string, cb: (string) -> nil): nil
        cb("mirror:" .. key)
    end
end

async function awaitCallbackMethod(source: CallbackSource): string
    return await source:fetch("a")
end

async function awaitCallbackInterface(remote: CallbackRemote): string
    return await remote:fetch("b")
end

export function run(): nil
    section("async / await")

    -- async functions accept an optional __done callback as last argument
    local mut got1: string = ""
    fetchHello(function(r: string): nil got1 = r end)
    expectEq("async single await", got1, "hello, world")

    local mut got2: string = ""
    fetchTwoStep(function(r: string): nil got2 = r end)
    expectEq("async sequential awaits", got2, "AABB")

    local mut got3: number = 0
    returnsNumber(7, function(r: number): nil got3 = r end)
    expectEq("async returns number through await", got3, 7)

    local fetcher = new Fetcher("x-")
    local mut got4: string = ""
    fetcher:fetch("a", function(r: string): nil got4 = r end)
    expectEq("async instance method", got4, "x-a")

    local mut got5: string = ""
    fetcher:fetchTwice("b", function(r: string): nil got5 = r end)
    expectEq("await on a method call", got5, "x-bx-b")

    local mut got6: string = ""
    Fetcher.ping(function(r: string): nil got6 = r end)
    expectEq("async static method", got6, "pong")

    local mut got7: string = ""
    ("hi"):fetchUpper(function(r: string): nil got7 = r end)
    expectEq("async extension method", got7, "HI")

    local mut got8: string = ""
    viaAny(fetcher, function(r: string): nil got8 = r end)
    expectEq("await through an any-typed receiver", got8, "x-dyn")
    local mut got9: string = ""
    awaitCallbackMethod(new CallbackSource(), function(r: string): nil got9 = r end)
    expectEq("await on a callback-last method", got9, "value:a")

    local mut got10: string = ""
    awaitCallbackInterface(new CallbackMirror(), function(r: string): nil got10 = r end)
    expectEq("await on a callback-last interface method", got10, "mirror:b")

    local mut got11: string = ""
    guarded(false, function(r: string): nil got11 = r end)
    expectEq("await inside try", got11, "ok")
    local mut got12: string = ""
    guarded(true, function(r: string): nil got12 = r end)
    expectEq("catch inside an async function", got12, "caught bad")

end
