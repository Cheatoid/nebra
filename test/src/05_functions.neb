import { section, expectEq, expect } from "_runner"

local function double(n: number): number
    return n * 2
end

local function greet(name: string, greeting: string = "Hello"): string
    return greeting .. ", " .. name
end

local function variadic(...: number): number
    local mut total: number = 0
    for _, v in ipairs({ ... }) do
        total = total + v
    end
    return total
end

local function divmod(a: number, b: number): (number, number)
    return a // b, a % b
end

local function makeCounter(): () -> number
    local mut n: number = 0
    return function(): number
        n = n + 1
        return n
    end
end

local function describe(value: number): string
    return "number"
end

local function describe(value: string): string
    return "string"
end

local function describe(...: any): string
    return "rest:" .. select("#", ...)
end

export function run(): nil
    section("functions")

    expectEq("simple call", double(21), 42)

    expectEq("default param used", greet("Nebra"), "Hello, Nebra")
    expectEq("default param overridden", greet("Nebra", "Hi"), "Hi, Nebra")

    expectEq("varargs sum 0", variadic(), 0)
    expectEq("varargs sum 4", variadic(1, 2, 3, 4), 10)

    -- Multi-return
    local q, r = divmod(17, 5)
    expectEq("multi-return q", q, 3)
    expectEq("multi-return r", r, 2)

    -- Closure
    local counter = makeCounter()
    expectEq("closure 1st call", counter(), 1)
    expectEq("closure 2nd call", counter(), 2)
    expectEq("closure 3rd call", counter(), 3)

    -- Pre/post increment + decrement (Nebra-specific operators)
    local mut a: number = 5
    a++
    expectEq("post-inc", a, 6)
    a~~
    expectEq("post-dec", a, 5)
    ++a
    expectEq("pre-inc", a, 6)
    ~~a
    expectEq("pre-dec", a, 5)

    -- Function-as-value
    local fn = double
    expectEq("function as value", fn(7), 14)

    -- Overloads of the same arity are told apart by their parameter types
    expectEq("overload picked by a number", describe(1), "number")
    expectEq("overload picked by a string", describe("a"), "string")
    local dynamic: any = "b"
    expectEq("overload picked at runtime for any", describe(dynamic), "string")
    expectEq("a varargs overload catches everything else", describe(true, 2), "rest:2")
    expectEq("a varargs overload catches no arguments", describe(), "rest:0")
end
