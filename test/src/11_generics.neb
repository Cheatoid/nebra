import { section, expectEq, expect } from "_runner"

class Box<T>
    value: T
    constructor(value: T)
        self.value = value
    end
    function get(): T
        return self.value
    end
end

interface HasName
    name: string
end

class Pet implements HasName
    name: string
    constructor(name: string)
        self.name = name
    end
end

class Registry<T extends HasName>
    items: T[]

    constructor()
        self.items = {}
    end

    function add(item: T): nil
        table.insert(self.items, item)
    end

    function nameAt(i: number): string
        return self.items[i].name
    end
end

interface Source<T>
    method next(): T?
end

class Stack<T> implements Source<T>
    items: T[]

    constructor(items: T[])
        self.items = items
    end

    function next(): T?
        return self.items[#self.items]
    end

    function map<U>(f: (T) -> U): Stack<U>
        local mapped: U[] = {}
        for i, item in ipairs(self.items) do
            mapped[i] = f(item)
        end
        return new Stack(mapped)
    end
end

class Numbers extends Stack<number>
    function sum(): number
        local mut total = 0
        for _, item in ipairs(self.items) do
            total = total + item
        end
        return total
    end
end

local function firstOf<T>(source: Source<T>): T?
    return source:next()
end

interface BusEvents
    "player:join": (string) -> nil
    score: (number) -> nil
end

class Bus
    listeners: { [string]: any[] } = {}

    function on<K extends keyof BusEvents>(name: K, callback: BusEvents[K]): nil
        local list = self.listeners[name] ?? {}
        table.insert(list, callback)
        self.listeners[name] = list
    end

    function count(name: keyof BusEvents): number
        return #(self.listeners[name] ?? {})
    end
end

local function speedOf(mode: "fast" | "slow"): number
    return mode == "fast" and 2 or 1
end

local function identity<T>(value: T): T
    return value
end

local function pair<A, B>(a: A, b: B): (A, B)
    return a, b
end

extend number
    function boxed(): Box<number>
        return new Box(self)
    end
end

export function run(): nil
    section("generics")

    expectEq("generic type inside an extend block", (7):boxed():get(), 7)

    local intBox: Box<number> = new Box(42)
    expectEq("Box<number>", intBox:get(), 42)

    local strBox: Box<string> = new Box("hi")
    expectEq("Box<string>", strBox:get(), "hi")

    -- Bound generic class
    local r: Registry<Pet> = new Registry()
    r:add(new Pet("Whiskers"))
    r:add(new Pet("Rex"))
    expectEq("Registry add+get name 1", r:nameAt(1), "Whiskers")
    expectEq("Registry add+get name 2", r:nameAt(2), "Rex")

    -- Generic function
    expectEq("identity<number>", identity(7), 7)
    expectEq("identity<string>", identity("ok"), "ok")

    -- Multi-param generic
    local s, n = pair("x", 9)
    expectEq("pair first", s, "x")
    expectEq("pair second", n, 9)

    local numbers = new Numbers({ 1, 2, 3 })
    local labels: Stack<string> = numbers:map(function(item: number): string return "n" .. tostring(item) end)
    expectEq("substituted base members", numbers:sum(), 6)
    expectEq("substituted generic method", labels:next(), "n3")
    expectEq("substituted interface", firstOf(numbers), 3)

    local anything: any = numbers
    expect("is checks the type arguments", anything is Stack<number>)
    expect("is rejects other type arguments", not (anything is Stack<string>))
    expect("instanceof checks the type arguments", anything instanceof Stack<number>)
    expect("is checks interface type arguments", anything is Source<number>)
    expect("is rejects other interface type arguments", not (anything is Source<string>))
    expect("a bare generic class matches every instantiation", anything is Stack)
    local mapped: any = labels
    expect("is checks the type arguments of a mapped value", mapped is Stack<string>)

    local bus = new Bus()
    local joined = ""
    bus:on("player:join", function(name)
        joined = name .. "!"
    end)
    bus:on("score", function(points)
        joined = joined .. tostring(points + 1)
    end)
    for _, callback in ipairs(bus.listeners["player:join"]) do
        callback("Ann")
    end
    for _, callback in ipairs(bus.listeners["score"]) do
        callback(1)
    end
    expectEq("keyof callbacks are registered by their key", bus:count("player:join") + bus:count("score"), 2)
    expectEq("contextually typed callbacks run", joined, "Ann!2")
    expectEq("literal type parameter", speedOf("fast") + speedOf("slow"), 3)
end
