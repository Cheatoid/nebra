{
  "name": "nebra",
  "displayName": "Nebra - A typed superset of Lua",
  "description": "Language support for Nebra, the typed superset of Lua",
  "version": "0.1.0",
  "publisher": "DasDarki",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://nebra-lang.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/nebra-lang/nebra.git"
  },
  "bugs": {
    "url": "https://github.com/nebra-lang/nebra/issues"
  },
  "keywords": [
    "nebra",
    "lua",
    "luajit",
    "transpiler",
    "type-checker"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nebra",
    "workspaceContains:**/nebra.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nebra",
        "aliases": [
          "Nebra",
          "nebra"
        ],
        "extensions": [
          ".neb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      },
      {
        "id": "nebra",
        "aliases": [
          "Nebra Declaration"
        ],
        "extensions": [
          ".d.neb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "nebra",
        "scopeName": "source.nebra",
        "path": "./syntaxes/nebra.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "nebra.compileFile",
        "title": "Nebra: Compile this file",
        "category": "Nebra"
      },
      {
        "command": "nebra.build",
        "title": "Build the project",
        "category": "Nebra"
      },
      {
        "command": "nebra.run",
        "title": "Run the project",
        "category": "Nebra"
      },
      {
        "command": "nebra.test",
        "title": "Run the tests",
        "category": "Nebra"
      },
      {
        "command": "nebra.watch",
        "title": "Watch and rebuild the project",
        "category": "Nebra"
      },
      {
        "command": "nebra.install",
        "title": "Install the dependencies",
        "category": "Nebra"
      },
      {
        "command": "nebra.compile",
        "title": "Compile a standalone binary",
        "category": "Nebra"
      },
      {
        "command": "nebra.docs",
        "title": "Generate the documentation",
        "category": "Nebra"
      },
      {
        "command": "nebra.runCommand",
        "title": "Run a nebra command...",
        "category": "Nebra"
      },
      {
        "command": "nebra.openConfig",
        "title": "Open the nearest nebra.toml",
        "category": "Nebra"
      },
      {
        "command": "nebra.restartServer",
        "title": "Restart the language server",
        "category": "Nebra"
      }
    ],
    "colors": [
      {
        "id": "nebra.sideClient",
        "description": "Marker in front of code that runs on the client.",
        "defaults": {
          "dark": "#E8A33D",
          "light": "#D9891A",
          "highContrast": "#FFB347"
        }
      },
      {
        "id": "nebra.sideServer",
        "description": "Marker in front of code that runs on the server.",
        "defaults": {
          "dark": "#33B5E5",
          "light": "#1E8FC4",
          "highContrast": "#5FD3FF"
        }
      },
      {
        "id": "nebra.sideShared",
        "description": "Marker in front of code that runs on both client and server.",
        "defaults": {
          "dark": "#5CC26B",
          "light": "#3A9A4A",
          "highContrast": "#7FE08C"
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "nebra",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The nebra command the task runs."
          }
        }
      }
    ],
    "configuration": {
      "title": "Nebra",
      "properties": {
        "nebra.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Nebra compiler executable. If empty, 'nebra' must be on PATH."
        },
        "nebra.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the Nebra language server."
        },
        "nebra.inlayHints.types": {
          "type": "boolean",
          "default": true,
          "description": "Show the inferred type of locals declared without an annotation."
        },
        "nebra.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter names before the arguments of a call."
        },
        "nebra.sideMarkers": {
          "type": "string",
          "enum": [
            "hover",
            "declarations",
            "all",
            "off"
          ],
          "enumDescriptions": [
            "Show where code runs only in the hover of a declaration or use.",
            "Also mark every declaration with a colored box.",
            "Also mark declarations and every use of something restricted to a side with a colored box.",
            "Show where code runs nowhere."
          ],
          "default": "hover",
          "description": "Where to show which side code runs on: orange for client, blue for server, green for shared."
        },
        "nebra.diagnostics.delay": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "Milliseconds the language server waits after typing stops before it updates diagnostics."
        }
      }
    },
    "tomlValidation": [
      {
        "fileMatch": "nebra.toml",
        "url": "./schemas/nebra.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "galleryBanner": {
    "color": "#040a14",
    "theme": "dark"
  }
}
